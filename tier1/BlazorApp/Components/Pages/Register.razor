@page "/register"
@inject IUserService UserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<div class="auth-wrapper">
    <AuthorizeView>
        <Authorized>
            <div class="auth-card text-center">
                <h1 class="auth-title">Hello, @context.User.Identity?.Name</h1>
                <p class="auth-hint">You are already registered and logged in.</p>
                <a href="/" class="auth-pill">To the catalogue</a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="auth-card">
                <h1 class="auth-title">Register</h1>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="auth-error">@errorMessage</div>
                }

                <EditForm Model="model" OnValidSubmit="RegisterAsync" Context="formContext">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="reg-name">User name</label>
                        <InputText id="reg-name" class="auth-input" @bind-Value="model.MemberName" autocomplete="username" />
                        <ValidationMessage For="@(() => model.MemberName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="reg-first">First name</label>
                        <InputText id="reg-first" class="auth-input" @bind-Value="model.FirstName" autocomplete="given-name" />
                        <ValidationMessage For="@(() => model.FirstName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="reg-last">Last name</label>
                        <InputText id="reg-last" class="auth-input" @bind-Value="model.LastName" autocomplete="family-name" />
                        <ValidationMessage For="@(() => model.LastName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="reg-email">Email</label>
                        <InputText id="reg-email" type="email" class="auth-input" @bind-Value="model.MemberEmail" autocomplete="email" />
                        <ValidationMessage For="@(() => model.MemberEmail)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="reg-password">Password</label>
                        <InputText id="reg-password" type="password" class="auth-input" @bind-Value="model.Password" autocomplete="new-password" />
                        <ValidationMessage For="@(() => model.Password)" class="text-danger small" />
                    </div>

                    <div class="auth-actions">
                        <a href="/" class="auth-pill auth-pill-outline">Cancel</a>
                        <button type="submit" class="auth-pill" disabled="@isSubmitting">
                            @(isSubmitting ? "Creating..." : "Register")
                        </button>
                    </div>
                </EditForm>

                <p class="auth-switch">Already have an account? <a href="login">Log in</a></p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private readonly CreateUserDto model = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        try
        {
            isSubmitting = true;
            await UserService.RegisterAsync(model);

            await ((AuthProvider)AuthProvider).Login(model.MemberName, model.Password);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}